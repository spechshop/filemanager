#!/usr/bin/env bash

# Web terminals and cron may inherit an incomplete PATH.
for fm_system_bin in /usr/local/bin /usr/bin /bin /usr/local/sbin /usr/sbin /sbin; do
    case ":${PATH:-}:" in *":$fm_system_bin:"*) ;; *) PATH="${PATH:+$PATH:}$fm_system_bin" ;; esac
done
unset fm_system_bin
export PATH

# Controla a instância do FileManager instalada neste diretório. O script
# também funciona quando chamado por meio de um link simbólico no PATH.

set +e

SCRIPT_PATH="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
    RESOLVED_PATH="$(readlink -f "$SCRIPT_PATH" 2>/dev/null)"
    [ -n "$RESOLVED_PATH" ] && SCRIPT_PATH="$RESOLVED_PATH"
fi
APP_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" 2>/dev/null && pwd -P)"
SERVER="$APP_DIR/server.php"
STATE_DIR="$APP_DIR/.runtime/supervision"
INSTANCE_ID="$(printf '%s' "$APP_DIR" | sha256sum | cut -c1-16)"
SERVICE="filemanager.service"
BOOT_ID="$(cat /proc/sys/kernel/random/boot_id)"
LOG_FILE="$APP_DIR/filemanager.log"
EVENT_LOG="$STATE_DIR/events.log"
START_LOG="$STATE_DIR/startup.log"
SYSTEM_CONTROLLER="/usr/local/bin/filemanagerctl"
SELF_PID="${BASHPID:-$$}"
# Control/supervisor helpers must not inherit the PHP ownership tag.
unset FILEMANAGER_MANAGED_INSTANCE

# A lingering user manager exists outside login shells too. Reconstruct the
# standard Ubuntu user bus when cron/runuser did not provide its environment.
USER_RUNTIME="/run/user/$(id -u)"
if [ -O "$USER_RUNTIME" ] && [ -S "$USER_RUNTIME/bus" ]; then
    export XDG_RUNTIME_DIR="$USER_RUNTIME"
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$USER_RUNTIME/bus"
fi

log()  { printf '\033[1;34m[filemanager]\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m[filemanager][ok]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[filemanager][aviso]\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31m[filemanager][erro]\033[0m %s\n' "$*" >&2; }

selected_system_unit() {
    case "$(cat "$STATE_DIR/backend" 2>/dev/null)" in watchdog|background|user) return 1 ;; esac
    system_unit_matches
}

selected_user_unit() {
    case "$(cat "$STATE_DIR/backend" 2>/dev/null)" in watchdog|background) return 1 ;; esac
    user_unit_matches
}

system_unit_matches() {
    command -v systemctl >/dev/null 2>&1 || return 1
    [ "$(systemctl show -p LoadState --value "$SERVICE" 2>/dev/null)" = "loaded" ] || return 1
    local directory
    directory="$(systemctl show -p WorkingDirectory --value "$SERVICE" 2>/dev/null)"
    [ "$(readlink -f -- "$directory" 2>/dev/null)" = "$APP_DIR" ]
}

user_unit_matches() {
    command -v systemctl >/dev/null 2>&1 || return 1
    [ "$(systemctl --user show -p LoadState --value "$SERVICE" 2>/dev/null)" = "loaded" ] || return 1
    local directory
    directory="$(systemctl --user show -p WorkingDirectory --value "$SERVICE" 2>/dev/null)"
    [ "$(readlink -f -- "$directory" 2>/dev/null)" = "$APP_DIR" ]
}

run_systemctl() {
    if [ "$(id -u 2>/dev/null)" = "0" ]; then
        systemctl "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo -n systemctl "$@"
    else
        err "O serviço é do sistema. Execute este comando com sudo."
        return 1
    fi
}

run_systemd_run() {
    if [ "$(id -u 2>/dev/null)" = "0" ]; then
        systemd-run "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo -n systemd-run "$@"
    else
        err "O serviço é do sistema. Execute este comando com sudo."
        return 1
    fi
}

server_pids() {
    local proc executable runtime candidate cwd resolved pid metadata state index option scope="${1:-all}"
    local -a argv
    for proc in /proc/[0-9]*; do
        [ -r "$proc/cmdline" ] || continue
        argv=()
        mapfile -d '' -t argv 2>/dev/null < "$proc/cmdline" || continue
        [ "${#argv[@]}" -gt 1 ] || continue
        executable="${argv[0]##*/}"
        case "$executable" in
            php*|pcg) runtime=php ;;
            node|nodejs) runtime=node ;;
            *) continue ;;
        esac

        # Match the script argument, never arbitrary code (-r/-e) or a path
        # mentioned in a shell command. Resolve relative scripts against the
        # process's cwd, not the directory where this controller was invoked.
        candidate=""
        index=1
        while [ "$index" -lt "${#argv[@]}" ]; do
            option="${argv[index]}"
            case "$runtime:$option" in
                php:-r*|php:-R*|php:-B*|php:-E*|php:-F*|php:--run*|php:-S|php:--server) break ;;
                node:-e*|node:-p*|node:--eval*|node:--print*) break ;;
                php:-c|php:-d|php:-z|php:--php-ini|php:--define|php:--zend-extension|node:-r|node:--require|node:--import|node:--loader)
                    index=$((index + 2)); continue ;;
                php:-f|php:--file|*:--)
                    index=$((index + 1)); candidate="${argv[index]:-}"; break ;;
                php:--file=*) candidate="${option#*=}"; break ;;
                *:-*) index=$((index + 1)); continue ;;
                *) candidate="$option"; break ;;
            esac
        done
        case "$runtime:${candidate##*/}" in
            php:server.php) ;;
            php:middleware.php) [ "$scope" != "main" ] || continue ;;
            php:pty.php|node:pty.js|node:lsp.js|node:gpt.js|node:codex-agent.js) [ "$scope" = "all" ] || continue ;;
            *) continue ;;
        esac
        if [[ "$candidate" = /* ]]; then
            resolved="$(readlink -f -- "$candidate" 2>/dev/null)"
        else
            cwd="$(readlink -f -- "$proc/cwd" 2>/dev/null)" || continue
            resolved="$(readlink -f -- "$cwd/$candidate" 2>/dev/null)"
        fi
        [ "$resolved" = "$APP_DIR/${candidate##*/}" ] || continue
        IFS= read -r metadata 2>/dev/null < "$proc/stat" || continue
        state="${metadata##*) }"
        case "$state" in Z\ *|X\ *) continue ;; esac
        pid="${proc##*/}"
        printf '%s\n' "$pid"
    done
    return 0
}

is_running() {
    [ -n "$(server_pids "${1:-all}")" ]
}

descendant_pids() {
    local parent="$1" child
    [ "$parent" = "$SELF_PID" ] && return 0
    for child in $(pgrep -P "$parent" 2>/dev/null); do
        [ "$child" = "$SELF_PID" ] && continue
        descendant_pids "$child"
        printf '%s\n' "$child"
    done
}

processes_alive() {
    local pid metadata state
    for pid in $1; do
        IFS= read -r metadata 2>/dev/null < "/proc/$pid/stat" || continue
        state="${metadata##*) }"
        case "$state" in Z\ *|X\ *) continue ;; esac
        kill -0 "$pid" 2>/dev/null && return 0
    done
    return 1
}

stop_processes() {
    local roots pids="" root pid attempt
    roots="$(server_pids)"
    [ -z "$roots" ] && return 0

    # Fora do systemd (nohup/screen), os processos middleware são filhos do
    # server.php. Capture a árvore antes de matar o pai para não deixar órfãos.
    for root in $roots; do
        pids="$pids $(descendant_pids "$root") $root"
    done

    # Quando o comando parte do terminal do próprio painel, este script é
    # um descendente de server.php. Não o inclua na árvore a encerrar, ou
    # o restart morre no stop e nunca alcança start_server.
    roots="$pids"
    pids=""
    for pid in $roots; do
        [ "$pid" = "$SELF_PID" ] && continue
        [ "$pid" = "$$" ] && continue
        pids="$pids $pid"
    done

    [ -n "$pids" ] && kill $pids 2>/dev/null
    for attempt in 1 2 3 4 5; do
        : "$attempt"
        processes_alive "$pids" || break
        sleep 1
    done

    processes_alive "$pids" && kill -KILL $pids 2>/dev/null
    sleep 1
    processes_alive "$pids" && return 1
    ! is_running
}

inside_service_cgroup() {
    [ -r "/proc/$SELF_PID/cgroup" ] || return 1
    grep -Eq "(^|/)$SERVICE(/|$)" "/proc/$SELF_PID/cgroup" 2>/dev/null
}

php_binary() {
    # A cache under /dev/shm may disappear at reboot. Always resolve from source.
    source "$APP_DIR/scripts/runtime-exec.sh" || return 1
    fm_php "$APP_DIR"
}

update_system_controller() {
    local source="$APP_DIR/filemanagerctl" resolved_target

    if [ ! -f "$source" ] || [ ! -f "$SERVER" ]; then
        err "Execute o filemanagerctl novo a partir do diretório do FileManager."
        return 1
    fi

    chmod +x "$source" 2>/dev/null || {
        err "Não foi possível tornar $source executável."
        return 1
    }

    resolved_target="$(readlink -f "$SYSTEM_CONTROLLER" 2>/dev/null)"
    if [ -L "$SYSTEM_CONTROLLER" ] && [ "$resolved_target" = "$source" ]; then
        ok "O controlador do sistema já aponta para a versão atual."
        return 0
    fi

    if [ -d "$SYSTEM_CONTROLLER" ]; then
        err "$SYSTEM_CONTROLLER é um diretório; não foi possível atualizá-lo."
        return 1
    fi

    log "Atualizando $SYSTEM_CONTROLLER..."
    if [ "$(id -u 2>/dev/null)" = "0" ]; then
        ln -sfn "$source" "$SYSTEM_CONTROLLER"
    elif command -v sudo >/dev/null 2>&1; then
        sudo ln -sfn "$source" "$SYSTEM_CONTROLLER"
    else
        err "Permissão de administrador necessária; execute: sudo $source update"
        return 1
    fi

    if [ "$(readlink -f "$SYSTEM_CONTROLLER" 2>/dev/null)" = "$source" ]; then
        ok "Controlador do sistema atualizado: $SYSTEM_CONTROLLER -> $source"
    else
        err "Não foi possível atualizar $SYSTEM_CONTROLLER."
        return 1
    fi
}

# State is data, never sourced as shell code. Administrative state uses
# lifecycle.lock; watchdog PID records also use the exclusive watchdog lock.
state_write() {
    local tmp
    tmp="$(mktemp "$STATE_DIR/.state.XXXXXX")" || return 1
    printf '%s\n' "$2" > "$tmp"
    chmod 600 "$tmp"
    if [ "$(id -u)" = 0 ]; then chown --reference="$STATE_DIR" "$tmp" || return 1; fi
    mv -f -- "$tmp" "$STATE_DIR/$1"
}

prepare_state() {
    command -v flock >/dev/null 2>&1 && command -v setsid >/dev/null 2>&1 || {
        err "flock e setsid (util-linux) são necessários."; return 1;
    }
    mkdir -p "$STATE_DIR" || return 1
    chmod 700 "$STATE_DIR" || return 1
    touch "$STATE_DIR/lifecycle.lock" "$STATE_DIR/watchdog.lock" || return 1
    if [ "$(id -u)" = 0 ]; then
        chown --reference="$STATE_DIR" "$STATE_DIR/"*.lock || return 1
    fi
    exec 9>"$STATE_DIR/lifecycle.lock" || return 1
    if [ -s "$STATE_DIR/unit" ]; then SERVICE="$(cat "$STATE_DIR/unit")"; fi
}

lock_lifecycle() { flock -x 9; }
unlock_lifecycle() { flock -u 9; }

# /proc start time plus boot ID protects against stale/reused PIDs.
process_identity() {
    local metadata
    IFS= read -r metadata 2>/dev/null < "/proc/$1/stat" || return 1
    metadata="${metadata##*) }"
    local -a fields
    read -r -a fields <<< "$metadata"
    case "${fields[0]}" in Z|X) return 1 ;; esac
    printf '%s %s %s\n' "$1" "${fields[19]}" "$BOOT_ID"
}

record_pid() {
    local identity
    identity="$(process_identity "$2")" || return 1
    state_write "$1" "$identity"
}

record_alive() {
    local pid ticks boot identity
    [ -r "$STATE_DIR/$1" ] || return 1
    read -r pid ticks boot < "$STATE_DIR/$1"
    [[ "$pid" =~ ^[0-9]+$ && "$ticks" =~ ^[0-9]+$ ]] || return 1
    [ "$boot" = "$BOOT_ID" ] || return 1
    identity="$(process_identity "$pid")" || return 1
    [ "$identity" = "$pid $ticks $boot" ] || return 1
    printf '%s\n' "$pid"
}

administratively_stopped() { [ "$(cat "$STATE_DIR/stopped-boot" 2>/dev/null)" = "$BOOT_ID" ]; }
autostart_enabled() { [ "$(cat "$STATE_DIR/autostart" 2>/dev/null)" = enabled ]; }
watchdog_allowed() {
    local backend
    backend="$(cat "$STATE_DIR/backend" 2>/dev/null)"
    [ "$backend" = watchdog ] || [ "$backend" = background ] || return 1
    ! administratively_stopped || return 1
    [ "$(cat "$STATE_DIR/run-boot" 2>/dev/null)" = "$BOOT_ID" ] || autostart_enabled
}

rotate_log() {
    local size
    size="$(stat -c %s "$1" 2>/dev/null)"
    if [ "${size:-0}" -ge 1048576 ]; then mv -f -- "$1" "$1.1"; fi
}

event() {
    rotate_log "$EVENT_LOG"
    printf '%s %s\n' "$(date -Is)" "$*" >> "$EVENT_LOG"
    if [ "$(id -u)" = 0 ]; then chown --reference="$STATE_DIR" "$EVENT_LOG" 2>/dev/null; fi
}

# A bounded pipe reader keeps PHP output bounded even when PHP floods stdout.
# At most one current log and one rotated log, about 1 MiB each.
log_stream() {
    local chunk size
    export LC_ALL=C
    size="$(stat -c %s "$LOG_FILE" 2>/dev/null)"
    size="${size:-0}"
    while IFS= read -r -n 4096 chunk || [ -n "$chunk" ]; do
        if [ "$size" -ge 1048576 ]; then
            mv -f -- "$LOG_FILE" "$LOG_FILE.1"
            size=0
        fi
        printf '%s\n' "$chunk" >> "$LOG_FILE"
        size=$((size + ${#chunk} + 1))
    done
}

# Find every member of the dedicated PHP session, including orphaned children.
# A session ID cannot be reused while any of its members still exists.
managed_session_pids() {
    local leader ticks boot proc metadata
    local -a fields
    [ -r "$STATE_DIR/main.pid" ] || return 0
    read -r leader ticks boot < "$STATE_DIR/main.pid"
    [ "$boot" = "$BOOT_ID" ] || return 0
    [[ "$leader" =~ ^[0-9]+$ && "$ticks" =~ ^[0-9]+$ ]] || return 0
    # A live/reused leader must still have the original creation time. If the
    # leader has exited, its SID remains reserved while original members live.
    if [ -r "/proc/$leader/stat" ]; then
        IFS= read -r metadata 2>/dev/null < "/proc/$leader/stat" || return 0
        metadata="${metadata##*) }"
        read -r -a fields <<< "$metadata"
        [ "${fields[19]}" = "$ticks" ] || return 0
    fi
    for proc in /proc/[0-9]*/stat; do
        IFS= read -r metadata 2>/dev/null < "$proc" || continue
        metadata="${metadata##*) }"
        read -r -a fields <<< "$metadata"
        [ "${fields[3]}" = "$leader" ] && [ "${fields[19]}" -ge "$ticks" ] || continue
        printf '%s\n' "${proc#/proc/}" | cut -d/ -f1
    done
}

# Children inherit an installation tag, even after setsid/reparenting. This
# covers terminal/bridge workers that leave the original PHP session.
managed_tag_pids() {
    local proc entry
    local -a environment
    for proc in /proc/[0-9]*; do
        [ "${proc##*/}" = "$SELF_PID" ] && continue
        [ -r "$proc/environ" ] || continue
        environment=()
        mapfile -d '' -t environment 2>/dev/null < "$proc/environ" || continue
        for entry in "${environment[@]}"; do
            if [ "$entry" = "FILEMANAGER_MANAGED_INSTANCE=$INSTANCE_ID" ]; then
                printf '%s\n' "${proc##*/}"
                break
            fi
        done
    done
}

stop_managed_processes() {
    local pids pid attempt filtered=""
    pids="$(managed_session_pids) $(managed_tag_pids)"
    for pid in $pids; do [ "$pid" = "$SELF_PID" ] || filtered="$filtered $pid"; done
    pids="$filtered"
    for pid in $pids; do
        [ "$pid" = "$SELF_PID" ] || kill -TERM "$pid" 2>/dev/null
    done
    for attempt in 1 2 3 4 5; do
        processes_alive "$pids" || break
        sleep 1
    done
    for pid in $pids; do
        [ "$pid" = "$SELF_PID" ] || kill -KILL "$pid" 2>/dev/null
    done
    stop_processes || return 1
    rm -f -- "$STATE_DIR/main.pid"
}

stop_watchdog() {
    local pid attempt
    pid="$(record_alive watchdog.pid)"
    if [ -n "$pid" ]; then
        kill -TERM "$pid" 2>/dev/null
        for attempt in 1 2 3 4 5; do
            record_alive watchdog.pid >/dev/null || break
            sleep 0.1
        done
        record_alive watchdog.pid >/dev/null && kill -KILL "$pid" 2>/dev/null
    fi
    # Wait for the exclusive watchdog lock to be released, not merely its PID.
    flock -x "$STATE_DIR/watchdog.lock" true || return 1
    stop_waiter
    rm -f -- "$STATE_DIR/watchdog.pid"
}

stop_server() {
    local failed=0
    state_write stopped-boot "$BOOT_ID" || return 1
    rm -f -- "$STATE_DIR/run-boot" "$STATE_DIR/restart-request"
    event "Parada administrativa (boot $BOOT_ID)."
    log "Parando o FileManager..."
    # Persist intent before stopping supervisors, including an active cron tick.
    if system_unit_matches && [ "$(systemctl show -p ActiveState --value "$SERVICE" 2>/dev/null)" != inactive ]; then
        run_systemctl stop "$SERVICE" >/dev/null || failed=1
    fi
    if user_unit_matches && [ "$(systemctl --user show -p ActiveState --value "$SERVICE" 2>/dev/null)" != inactive ]; then
        systemctl --user stop "$SERVICE" >/dev/null || failed=1
    fi
    stop_watchdog || failed=1
    stop_managed_processes || failed=1
    if [ "$failed" -ne 0 ] || is_running; then
        err "Alguns processos ou supervisores não puderam ser encerrados; verifique as permissões."
        return 1
    fi
    ok "FileManager desligado."
}

launch_watchdog() {
    # Detach from the terminal and do not inherit lifecycle locks.
    # Caught signals in the controller become default in the exec child. Do
    # not require GNU env --default-signal (absent on older hosting systems).
    local -a reset_signals=()
    if env --default-signal=TERM,INT /bin/true >/dev/null 2>&1; then
        reset_signals=(env --default-signal=TERM,INT)
    fi
    rotate_log "$START_LOG"
    nohup setsid "${reset_signals[@]}" "$BASH" "$SCRIPT_PATH" __watchdog </dev/null >>"$START_LOG" 2>&1 9>&- &
    LAUNCH_PID=$!
}

stop_waiter() {
    local pid record
    for record in waiter.pid recovery.pid; do
        pid="$(record_alive "$record")"
        [ -z "$pid" ] || kill -TERM "$pid" 2>/dev/null
        rm -f -- "$STATE_DIR/$record"
    done
}

watchdog() {
    local php_bin main_pid result adopted recovery_timer waiter_pid
    exec 8>"$STATE_DIR/watchdog.lock" || return 1
    flock -n 8 || return 0
    # Never block on lifecycle.lock while an administrator waits for our exit.
    # Retrying is only needed during a concurrent administrative operation.
    trap 'stop_waiter; exit 0' TERM INT HUP
    record_pid watchdog.pid "$SELF_PID" || { err "Não foi possível registrar o PID do watchdog."; return 1; }
    while :; do
        rotate_log "$START_LOG"
        exec >>"$START_LOG" 2>&1
        if ! flock -n 9; then sleep 1; continue; fi
        if ! watchdog_allowed; then stop_waiter; unlock_lifecycle; return 0; fi
        stop_waiter
        # Adopt PHP surviving SIGKILL of the previous watchdog, never duplicate it.
        main_pid="$(record_alive main.pid)"
        adopted=1
        if [ -z "$main_pid" ]; then
            stop_managed_processes || { unlock_lifecycle; return 1; }
            state_write startup-stage 'Validando ou recuperando o PCG' || return 1
            php_bin="$(php_binary)" || {
                state_write startup-failure 'Nenhum PCG executável validado; a aplicação PHP não chegou a iniciar.'
                event "Runtime PHP indisponível."; unlock_lifecycle; return 1;
            }
            state_write startup-stage "Executando $php_bin $SERVER" || return 1
            cd "$APP_DIR" || return 1
            FILEMANAGER_MANAGED_INSTANCE="$INSTANCE_ID" setsid "$php_bin" "$SERVER" 8>&- 9>&- > >("$BASH" "$SCRIPT_PATH" __log 8>&- 9>&-) 2>&1 &
            main_pid=$!
            record_pid main.pid "$main_pid"
            adopted=0
            event "PHP iniciado: PID $main_pid."
        fi
        unlock_lifecycle
        if [ "$adopted" -eq 0 ]; then
            wait "$main_pid"
            result=$?
        else
            event "PHP adotado após recuperação do watchdog: PID $main_pid."
            # procps pidwait uses pidfd: a blocking wait even for a non-child.
            # Older distributions fall back to one quiet check per second.
            if command -v pidwait >/dev/null 2>&1; then
                pidwait -F <(printf '%s\n' "$main_pid") 8>&- 9>&- &
                waiter_pid=$!
                record_pid waiter.pid "$waiter_pid"
                wait "$waiter_pid"
                rm -f -- "$STATE_DIR/waiter.pid"
            fi
            while record_alive main.pid >/dev/null; do sleep 1; done
            result=unknown
        fi
        state_write startup-failure "PHP terminou (PID $main_pid, status $result); recuperação em 2s."
        event "PHP terminou inesperadamente (PID $main_pid, status $result); recuperação em 2s."
        sleep 2 8>&- 9>&- &
        recovery_timer=$!
        record_pid recovery.pid "$recovery_timer"
        if flock -n 9; then
            if watchdog_allowed; then stop_managed_processes; fi
            unlock_lifecycle
        fi
        wait "$recovery_timer"
        rm -f -- "$STATE_DIR/recovery.pid"
    done
}

cron_line_belongs_to_installation() {
    local line="$1"
    [[ "$line" = *"# filemanager:$INSTANCE_ID" ]] && return 0
    # Migrate only old @reboot PHP launchers with this exact script argument.
    [[ "$line" = @reboot\ * ]] || return 1
    [[ "$line" = *php* || "$line" = *pcg* ]] || return 1
    [[ "$line" = *"'$SERVER'"* || "$line" = *"\"$SERVER\""* || "$line" = *" $SERVER "* || "$line" = *" $SERVER" ]]
}

cron_update() {
    local mode="$1" cron line command_line tmp lock_dir
    command -v crontab >/dev/null 2>&1 || { [ "$mode" = remove ]; return; }
    lock_dir="/tmp/filemanager-crontab-$(id -u)"
    (umask 077; mkdir -p "$lock_dir") || return 1
    [ -O "$lock_dir" ] && [ ! -L "$lock_dir" ] || return 1
    exec 7>"$lock_dir/lock" || return 1
    flock -x 7 || return 1
    cron="$(crontab -l 2>"$lock_dir/error")"
    if [ "$?" -ne 0 ] && ! grep -qi 'no crontab' "$lock_dir/error"; then
        err "Não foi possível ler o crontab; nenhuma entrada foi substituída."
        flock -u 7; return 1
    fi
    tmp="$(mktemp "$lock_dir/cron.XXXXXX")" || return 1
    while IFS= read -r line; do
        cron_line_belongs_to_installation "$line" || printf '%s\n' "$line" >> "$tmp"
    done <<< "$cron"
    if [ "$mode" = install ]; then
        # POSIX shell quoting, including spaces, quotes, and cron's special %.
        command_line="$(printf '%s' "$SCRIPT_PATH" | sed "s/'/'\\\\''/g")"
        command_line="/bin/bash '$command_line' __tick >/dev/null 2>&1"
        command_line="${command_line//%/\\%}"
        printf '@reboot %s # filemanager:%s\n' "$command_line" "$INSTANCE_ID" >> "$tmp"
        printf '* * * * * %s # filemanager:%s\n' "$command_line" "$INSTANCE_ID" >> "$tmp"
    fi
    crontab "$tmp"
    local result=$?
    rm -f -- "$tmp"
    flock -u 7
    return "$result"
}

user_linger_available() {
    command -v loginctl >/dev/null 2>&1 || return 1
    [ "$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null)" = yes ]
}

configure_autostart() {
    if selected_system_unit; then
        run_systemctl enable "$SERVICE" >/dev/null || return 1
        cron_update remove || return 1
        state_write backend system || return 1
    elif selected_user_unit && user_linger_available; then
        systemctl --user enable "$SERVICE" >/dev/null || return 1
        cron_update remove || return 1
        state_write backend user || return 1
    else
        # A session-bound user service must not race the persistent watchdog.
        if user_unit_matches; then
            systemctl --user disable --now "$SERVICE" >/dev/null || return 1
        fi
        state_write backend watchdog || return 1
        cron_update install || { state_write backend background; return 1; }
    fi
    state_write autostart enabled
}

show_start_failure() {
    local phase failure watchdog_pid launch_status
    phase=$(cat "$STATE_DIR/startup-stage" 2>/dev/null)
    failure=$(cat "$STATE_DIR/startup-failure" 2>/dev/null)
    watchdog_pid=$(record_alive watchdog.pid)
    err "O FileManager não iniciou. Diagnóstico desta tentativa:"
    [ -z "$phase" ] || printf 'Etapa: %s\n' "$phase" >&2
    [ -z "$failure" ] || printf 'Falha: %s\n' "$failure" >&2
    if [ -n "${LAUNCH_PID:-}" ] && ! process_identity "$LAUNCH_PID" >/dev/null; then
        if wait "$LAUNCH_PID"; then launch_status=0; else launch_status=$?; fi
        printf 'Lançador do watchdog encerrou com status %s.\n' "$launch_status" >&2
    fi
    printf 'Watchdog: %s\n' "${watchdog_pid:-não está executando}" >&2
    if [ -s "$START_LOG" ]; then
        printf 'Saída da inicialização:\n' >&2
        tail -c 8192 "$START_LOG" >&2
    else
        printf 'O lançador não produziu saída de diagnóstico.\n' >&2
    fi
    if [ -s "$LOG_FILE" ]; then
        printf 'Saída recente da aplicação:\n' >&2
        tail -c 8192 "$LOG_FILE" >&2
    else
        printf 'A aplicação não produziu saída em filemanager.log.\n' >&2
    fi
    if selected_system_unit || selected_user_unit; then
        printf 'Diagnóstico do serviço %s:\n' "$SERVICE" >&2
        if selected_system_unit; then
            systemctl show "$SERVICE" -p ActiveState -p SubState -p Result -p ExecMainStatus >&2
            journalctl -u "$SERVICE" -n 20 --no-pager >&2
        else
            systemctl --user show "$SERVICE" -p ActiveState -p SubState -p Result -p ExecMainStatus >&2
            journalctl --user -u "$SERVICE" -n 20 --no-pager >&2
        fi
    fi
}

start_server() {
    local attempt backend main_pid previous_pid='' stable=0
    LAUNCH_PID=''
    (umask 077; : > "$START_LOG") || { err "Não foi possível gravar o diagnóstico em $START_LOG."; return 1; }
    rm -f -- "$STATE_DIR/startup-failure"
    state_write startup-stage 'Iniciando o supervisor' || return 1
    rm -f -- "$STATE_DIR/stopped-boot" "$STATE_DIR/restart-request"
    state_write run-boot "$BOOT_ID" || return 1
    backend="$(cat "$STATE_DIR/backend" 2>/dev/null)"
    if selected_system_unit; then
        stop_watchdog || return 1
        state_write backend system || return 1
        if ! systemctl is-active --quiet "$SERVICE" 2>/dev/null; then
            stop_managed_processes || return 1
        fi
        run_systemctl start "$SERVICE" >/dev/null || return 1
    elif user_unit_matches && [ "$backend" != watchdog ] && [ "$backend" != background ]; then
        stop_watchdog || return 1
        state_write backend user || return 1
        if ! systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
            stop_managed_processes || return 1
        fi
        systemctl --user start "$SERVICE" >/dev/null || return 1
    else
        [ "$backend" = watchdog ] || state_write backend background || return 1
        # Adopt existing main processes during upgrades, cleaning stale bridges.
        if [ -z "$(record_alive main.pid)" ]; then
            if is_running main; then
                local pid
                pid="$(server_pids main | head -n1)"
                record_pid main.pid "$pid" || return 1
            fi
        fi
        launch_watchdog
    fi
    # The watchdog needs the same lifecycle lock before creating/adopting PHP.
    unlock_lifecycle
    for attempt in {1..150}; do
        main_pid=$(server_pids main | head -n1)
        if [ -n "$main_pid" ] && [ "$main_pid" = "$previous_pid" ]; then stable=$((stable + 1)); else stable=0; fi
        previous_pid="$main_pid"
        if [ "$stable" -ge 2 ]; then lock_lifecycle; ok "FileManager iniciado."; return 0; fi
        [ ! -s "$STATE_DIR/startup-failure" ] || break
        if [ -n "$LAUNCH_PID" ] && ! process_identity "$LAUNCH_PID" >/dev/null \
            && ! record_alive watchdog.pid >/dev/null; then break; fi
        sleep 0.1
    done
    lock_lifecycle
    show_start_failure
    return 1
}

restart_server() {
    # Commands executed inside a systemd cgroup need an external helper.
    if inside_service_cgroup && { system_unit_matches || user_unit_matches; }; then
        local request
        request="$(cat /proc/sys/kernel/random/uuid)"
        state_write restart-request "$request" || return 1
        if system_unit_matches; then
            run_systemd_run --quiet --collect --unit="filemanager-restart-$SELF_PID" --on-active=2s \
                "$BASH" "$SCRIPT_PATH" __restart "$request" || return 1
        else
            systemd-run --user --quiet --collect --unit="filemanager-restart-$SELF_PID" --on-active=2s \
                "$BASH" "$SCRIPT_PATH" __restart "$request" || return 1
        fi
        ok "Reinício agendado. O painel pode desconectar por alguns segundos."
        return 0
    fi
    stop_server || return 1
    start_server
}

disable_autostart() {
    local failed=0
    # Disable persistent launchers BEFORE stop: systemd may terminate this
    # controller too when it was invoked from a terminal inside the panel.
    state_write autostart disabled || return 1
    state_write stopped-boot "$BOOT_ID" || return 1
    rm -f -- "$STATE_DIR/run-boot" "$STATE_DIR/restart-request"
    cron_update remove || failed=1
    if system_unit_matches && systemctl is-enabled --quiet "$SERVICE" 2>/dev/null; then
        run_systemctl disable "$SERVICE" >/dev/null || failed=1
    fi
    if user_unit_matches && systemctl --user is-enabled --quiet "$SERVICE" 2>/dev/null; then
        systemctl --user disable "$SERVICE" >/dev/null || failed=1
    fi
    stop_server || failed=1
    [ "$failed" -eq 0 ] || { err "Não foi possível desativar todos os mecanismos de inicialização."; return 1; }
    ok "Inicialização automática desativada."
}

enable_autostart() {
    configure_autostart || { warn "Autostart indisponível; verifique systemd/linger e permissões do cron."; return 1; }
    ok "Inicialização automática ativada."
    start_server
}

show_status() {
    local pid supervisor backend autostart=desativado automatic=inativa main_pids
    backend="$(cat "$STATE_DIR/backend" 2>/dev/null)"
    if selected_system_unit; then
        supervisor="systemd (sistema): $SERVICE"
        systemctl is-enabled --quiet "$SERVICE" 2>/dev/null && autostart=ativado
        if systemctl is-active --quiet "$SERVICE" 2>/dev/null; then automatic=ativa; else supervisor="$supervisor; processo background se ativo"; fi
    elif user_unit_matches && [ "$backend" != watchdog ] && [ "$backend" != background ]; then
        supervisor="systemd (usuário): $SERVICE"
        systemctl --user is-enabled --quiet "$SERVICE" 2>/dev/null && autostart=ativado
        systemctl --user is-active --quiet "$SERVICE" 2>/dev/null && automatic=ativa
    else
        pid="$(record_alive watchdog.pid)"
        supervisor="${backend:-background} (PID: ${pid:-ausente})"
        [ -n "$pid" ] && watchdog_allowed && automatic=ativa
        if autostart_enabled && crontab -l 2>/dev/null | grep -qF "# filemanager:$INSTANCE_ID"; then autostart=ativado; fi
    fi
    log "Supervisor: $supervisor"
    log "Supervisão automática: $automatic"
    log "Autostart: $autostart"
    if administratively_stopped; then log "Parada administrativa: sim (boot atual)"; else log "Parada administrativa: não"; fi
    log "Logs: $LOG_FILE; $EVENT_LOG; journalctl [--user] -u $SERVICE (systemd)"
    main_pids="$(server_pids main)"
    if [ -n "$main_pids" ]; then
        ok "FileManager está rodando (PID(s): $(tr '\n' ' ' <<< "$main_pids"))."
    elif is_running; then
        warn "Há serviços auxiliares ativos sem o servidor. Execute '$0 stop' para encerrá-los."
        return 1
    else
        warn "FileManager está desligado."
        return 1
    fi
}

usage() {
    printf 'Uso: %s {start|stop|restart|status|disable|enable|update}\n' "${0##*/}"
    printf '  stop     desliga agora; continua habilitado para o próximo boot\n'
    printf '  disable  desliga e também desativa o autostart e o watchdog\n'
    printf '  update   atualiza o filemanagerctl do sistema (/usr/local/bin)\n'
}

case "${1:-}" in
    update|--update|update-system|--update-system) update_system_controller; exit $? ;;
    start|stop|restart|status|disable|enable|__watchdog|__tick|__log|__restart|__configure|__install-enable|__install-background|__migrate-stop) ;;
    *) usage; exit 2 ;;
esac
# Root controls a user-owned watchdog through that account's crontab. This
# also keeps private state/log files writable for www-data after maintenance.
if [ "$(id -u)" = 0 ] && [ -d "$STATE_DIR" ]; then
    STATE_OWNER="$(stat -c %u "$STATE_DIR")"
    case "$(cat "$STATE_DIR/backend" 2>/dev/null)" in
        watchdog|background|user)
            if [ "$STATE_OWNER" != 0 ]; then
                OWNER_NAME="$(id -un "$STATE_OWNER")" || exit 1
                exec runuser -u "$OWNER_NAME" -- "$BASH" "$SCRIPT_PATH" "$@"
            fi
            ;;
    esac
fi
prepare_state || exit 1
case "$1" in
    __log) log_stream; exit $? ;;
    __watchdog) watchdog; exit $? ;;
esac
lock_lifecycle || exit 1
# The controller may be launched from a PTY owned by this server.
trap ':' HUP TERM
case "$1" in
    start) start_server ;;
    stop) stop_server ;;
    restart) restart_server ;;
    status) show_status ;;
    disable) disable_autostart ;;
    enable) enable_autostart ;;
    __migrate-stop)
        state_write autostart disabled && stop_server || exit 1
        # No usable cron must still permit the detached fallback for this boot.
        # A normal disable continues to report cron cleanup failures to callers.
        cron_update remove || warn "Cron inacessível; entradas anteriores não puderam ser verificadas/removidas."
        ;;
    __install-enable)
        if [ "$2" = disabled ]; then
            disable_autostart
        elif configure_autostart; then
            if [ "$3" != "$BOOT_ID" ]; then start_server; fi
        else
            exit 1
        fi
        ;;
    __install-background)
        # Migration temporarily disables autostart. Do not mistake that internal
        # state for an operator's disable on the next installation.
        state_write autostart "${2:-unavailable}" || exit 1
        if [ "$2" = disabled ] || [ "$3" = "$BOOT_ID" ]; then
            warn "Parada/desativação administrativa preservada; servidor não iniciado. Para iniciar: bash $SCRIPT_PATH start"
        else
            start_server
        fi
        ;;
    __configure)
        state_write php "$2" && state_write unit "$3" && state_write backend "$4"
        ;;
    __tick)
        if watchdog_allowed; then launch_watchdog; fi
        ;;
    __restart)
        if [ "$(cat "$STATE_DIR/restart-request" 2>/dev/null)" = "$2" ]; then restart_server; fi
        ;;
esac
