#!/usr/bin/env bash

# Controla a instância do FileManager instalada neste diretório. O script
# também funciona quando chamado por meio de um link simbólico no PATH.

set +e

SCRIPT_PATH="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
    RESOLVED_PATH="$(readlink -f "$SCRIPT_PATH" 2>/dev/null)"
    [ -n "$RESOLVED_PATH" ] && SCRIPT_PATH="$RESOLVED_PATH"
fi
APP_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" 2>/dev/null && pwd -P)"
SERVER="$APP_DIR/server.php"
SERVICE="filemanager.service"
SYSTEM_CONTROLLER="/usr/local/bin/filemanagerctl"
SELF_PID="${BASHPID:-$$}"

log()  { printf '\033[1;34m[filemanager]\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m[filemanager][ok]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[filemanager][aviso]\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31m[filemanager][erro]\033[0m %s\n' "$*" >&2; }

system_unit_matches() {
    command -v systemctl >/dev/null 2>&1 || return 1
    [ "$(systemctl show -p LoadState --value "$SERVICE" 2>/dev/null)" = "loaded" ] || return 1
    [ "$(systemctl show -p WorkingDirectory --value "$SERVICE" 2>/dev/null)" = "$APP_DIR" ]
}

user_unit_matches() {
    command -v systemctl >/dev/null 2>&1 || return 1
    [ "$(systemctl --user show -p LoadState --value "$SERVICE" 2>/dev/null)" = "loaded" ] || return 1
    [ "$(systemctl --user show -p WorkingDirectory --value "$SERVICE" 2>/dev/null)" = "$APP_DIR" ]
}

run_systemctl() {
    if [ "$(id -u 2>/dev/null)" = "0" ]; then
        systemctl "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo systemctl "$@"
    else
        err "O serviço é do sistema. Execute este comando com sudo."
        return 1
    fi
}

run_systemd_run() {
    if [ "$(id -u 2>/dev/null)" = "0" ]; then
        systemd-run "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo systemd-run "$@"
    else
        err "O serviço é do sistema. Execute este comando com sudo."
        return 1
    fi
}

server_pids() {
    pgrep -f -- "$SERVER" 2>/dev/null
}

is_running() {
    [ -n "$(server_pids)" ]
}

descendant_pids() {
    local parent="$1" child
    for child in $(pgrep -P "$parent" 2>/dev/null); do
        descendant_pids "$child"
        printf '%s\n' "$child"
    done
}

processes_alive() {
    local pid
    for pid in $1; do
        kill -0 "$pid" 2>/dev/null && return 0
    done
    return 1
}

stop_processes() {
    local roots pids="" root pid attempt
    roots="$(server_pids)"
    [ -z "$roots" ] && return 0

    # Fora do systemd (nohup/screen), os processos middleware são filhos do
    # server.php. Capture a árvore antes de matar o pai para não deixar órfãos.
    for root in $roots; do
        pids="$pids $(descendant_pids "$root") $root"
    done

    # Quando o comando parte do terminal do próprio painel, este script é
    # um descendente de server.php. Não o inclua na árvore a encerrar, ou
    # o restart morre no stop e nunca alcança start_server.
    roots="$pids"
    pids=""
    for pid in $roots; do
        [ "$pid" = "$SELF_PID" ] && continue
        [ "$pid" = "$$" ] && continue
        pids="$pids $pid"
    done

    [ -n "$pids" ] && kill $pids 2>/dev/null
    for attempt in 1 2 3 4 5; do
        processes_alive "$pids" || break
        sleep 1
    done

    processes_alive "$pids" && kill -KILL $pids 2>/dev/null
    sleep 1
    ! is_running
}

inside_service_cgroup() {
    [ -r "/proc/$SELF_PID/cgroup" ] || return 1
    grep -Eq "(^|/)$SERVICE(/|$)" "/proc/$SELF_PID/cgroup" 2>/dev/null
}

schedule_system_restart() {
    local unit="filemanager-restart-$SELF_PID" systemctl_bin
    systemctl_bin="$(command -v systemctl)" || return 1

    # Um processo iniciado pelo painel pertence ao cgroup de filemanager.service.
    # O helper transitório fica em outra unidade e, por isso, sobrevive ao stop
    # para concluir o start depois que a resposta do comando for entregue.
    run_systemd_run --quiet --collect --unit="$unit" --on-active=2s \
        "$systemctl_bin" restart "$SERVICE" || return 1

    ok "Reinício agendado. O painel pode desconectar por alguns segundos."
}

schedule_user_restart() {
    local unit="filemanager-restart-$SELF_PID" systemctl_bin
    systemctl_bin="$(command -v systemctl)" || return 1

    systemd-run --user --quiet --collect --unit="$unit" --on-active=2s \
        "$systemctl_bin" --user restart "$SERVICE" || return 1

    ok "Reinício agendado. O painel pode desconectar por alguns segundos."
}

stop_server() {
    local failed=0

    log "Parando o FileManager..."

    if system_unit_matches; then
        run_systemctl stop "$SERVICE" >/dev/null || failed=1
    fi

    if user_unit_matches; then
        systemctl --user stop "$SERVICE" >/dev/null || failed=1
    fi

    if command -v screen >/dev/null 2>&1 && screen -list 2>/dev/null | grep -q '[.]filemanager'; then
        screen -S filemanager -X quit >/dev/null 2>&1
    fi

    stop_processes || failed=1

    if is_running; then
        err "O servidor ainda está rodando. Tente: sudo $APP_DIR/filemanagerctl stop"
        return 1
    fi

    if [ "$failed" -ne 0 ]; then
        warn "O processo parou, mas algum supervisor não pôde ser parado; ele pode iniciar novamente."
        return 1
    fi

    ok "FileManager desligado."
}

php_binary() {
    if [ -x "$APP_DIR/pcg" ]; then
        printf '%s\n' "$APP_DIR/pcg"
    elif command -v pcg >/dev/null 2>&1; then
        command -v pcg
    elif command -v php >/dev/null 2>&1; then
        command -v php
    else
        return 1
    fi
}

start_server() {
    local php_bin

    if is_running; then
        ok "FileManager já está rodando."
        return 0
    fi

    log "Iniciando o FileManager..."
    if system_unit_matches; then
        run_systemctl start "$SERVICE" >/dev/null || return 1
    elif user_unit_matches; then
        systemctl --user start "$SERVICE" >/dev/null || return 1
    else
        php_bin="$(php_binary)" || { err "Binário PHP não encontrado."; return 1; }
        if command -v screen >/dev/null 2>&1; then
            screen -dmS filemanager bash -c "cd '$APP_DIR' && '$php_bin' '$SERVER' >> '$APP_DIR/filemanager.log' 2>&1"
        else
            cd "$APP_DIR" || return 1
            nohup "$php_bin" "$SERVER" >> "$APP_DIR/filemanager.log" 2>&1 &
        fi
    fi

    sleep 1
    if is_running; then
        ok "FileManager iniciado."
    else
        err "O FileManager não iniciou. Consulte $APP_DIR/filemanager.log ou o journalctl."
        return 1
    fi
}

restart_server() {
    local stopped

    log "Reiniciando o FileManager..."

    if system_unit_matches; then
        if inside_service_cgroup; then
            schedule_system_restart
            return $?
        fi
        run_systemctl restart "$SERVICE" >/dev/null || return 1
    elif user_unit_matches; then
        if inside_service_cgroup; then
            schedule_user_restart
            return $?
        fi
        systemctl --user restart "$SERVICE" >/dev/null || return 1
    else
        # Se o shell/PTY pai for encerrado junto com server.php, ele pode mandar
        # SIGHUP a este controlador. Ignore-o somente durante o stop e restaure
        # os sinais antes de iniciar o novo servidor.
        trap '' HUP TERM
        stop_server
        stopped=$?
        trap - HUP TERM
        [ "$stopped" -eq 0 ] || return "$stopped"
        start_server
        return $?
    fi

    sleep 1
    if is_running; then
        ok "FileManager reiniciado."
    else
        err "O FileManager não reiniciou. Consulte $APP_DIR/filemanager.log ou o journalctl."
        return 1
    fi
}

update_system_controller() {
    local source="$APP_DIR/filemanagerctl" resolved_target

    if [ ! -f "$source" ] || [ ! -f "$SERVER" ]; then
        err "Execute o filemanagerctl novo a partir do diretório do FileManager."
        return 1
    fi

    chmod +x "$source" 2>/dev/null || {
        err "Não foi possível tornar $source executável."
        return 1
    }

    resolved_target="$(readlink -f "$SYSTEM_CONTROLLER" 2>/dev/null)"
    if [ -L "$SYSTEM_CONTROLLER" ] && [ "$resolved_target" = "$source" ]; then
        ok "O controlador do sistema já aponta para a versão atual."
        return 0
    fi

    if [ -d "$SYSTEM_CONTROLLER" ]; then
        err "$SYSTEM_CONTROLLER é um diretório; não foi possível atualizá-lo."
        return 1
    fi

    log "Atualizando $SYSTEM_CONTROLLER..."
    if [ "$(id -u 2>/dev/null)" = "0" ]; then
        ln -sfn "$source" "$SYSTEM_CONTROLLER"
    elif command -v sudo >/dev/null 2>&1; then
        sudo ln -sfn "$source" "$SYSTEM_CONTROLLER"
    else
        err "Permissão de administrador necessária; execute: sudo $source update"
        return 1
    fi

    if [ "$(readlink -f "$SYSTEM_CONTROLLER" 2>/dev/null)" = "$source" ]; then
        ok "Controlador do sistema atualizado: $SYSTEM_CONTROLLER -> $source"
    else
        err "Não foi possível atualizar $SYSTEM_CONTROLLER."
        return 1
    fi
}

disable_autostart() {
    local cron tmp failed=0

    stop_server || failed=1

    if system_unit_matches; then
        run_systemctl disable "$SERVICE" >/dev/null || failed=1
    fi
    if user_unit_matches; then
        systemctl --user disable "$SERVICE" >/dev/null || failed=1
    fi

    if command -v crontab >/dev/null 2>&1; then
        cron="$(crontab -l 2>/dev/null)"
        if printf '%s\n' "$cron" | grep -qF "$SERVER"; then
            tmp="$(mktemp)" || return 1
            printf '%s\n' "$cron" | grep -vF "$SERVER" > "$tmp"
            crontab "$tmp" || failed=1
            rm -f -- "$tmp"
        fi
    fi

    if [ "$failed" -eq 0 ]; then
        ok "Inicialização automática desativada."
    else
        err "Não foi possível desativar todos os mecanismos de inicialização."
        return 1
    fi
}

enable_autostart() {
    local enabled=0 php_bin cron cron_line

    if system_unit_matches; then
        run_systemctl enable "$SERVICE" >/dev/null && enabled=1
    fi
    if user_unit_matches; then
        systemctl --user enable "$SERVICE" >/dev/null && enabled=1
    fi

    if [ "$enabled" -eq 0 ] && command -v crontab >/dev/null 2>&1; then
        php_bin="$(php_binary)" || { err "Binário PHP não encontrado."; return 1; }
        cron="$(crontab -l 2>/dev/null)"
        cron_line="@reboot cd '$APP_DIR' && '$php_bin' '$SERVER' >> '$APP_DIR/filemanager.log' 2>&1"
        if printf '%s\n' "$cron" | grep -qF "$cron_line"; then
            enabled=1
        elif printf '%s\n' "$cron" | grep -qF "$SERVER"; then
            cron="$(printf '%s\n' "$cron" | grep -vF "$SERVER")"
            { printf '%s\n' "$cron"; printf '%s\n' "$cron_line"; } | crontab - && enabled=1
        else
            { printf '%s\n' "$cron"; printf '%s\n' "$cron_line"; } | crontab - && enabled=1
        fi
    fi

    if [ "$enabled" -eq 0 ]; then
        warn "Não foi possível configurar systemd nem cron; execute novamente o installer.sh."
        return 1
    fi

    ok "Inicialização automática ativada."
    start_server
}

show_status() {
    if system_unit_matches; then
        log "Supervisor: systemd (sistema)"
        systemctl status "$SERVICE" --no-pager 2>/dev/null | sed -n '1,8p'
    elif user_unit_matches; then
        log "Supervisor: systemd (usuário)"
        systemctl --user status "$SERVICE" --no-pager 2>/dev/null | sed -n '1,8p'
    elif command -v screen >/dev/null 2>&1 && screen -list 2>/dev/null | grep -q '[.]filemanager'; then
        log "Supervisor: screen"
    else
        log "Supervisor: processo em background"
    fi

    if is_running; then
        ok "FileManager está rodando (PID(s): $(server_pids | tr '\n' ' ' | sed 's/ $//'))."
    else
        warn "FileManager está desligado."
        return 1
    fi
}

usage() {
    printf 'Uso: %s {start|stop|restart|status|disable|enable|update}\n' "${0##*/}"
    printf '  stop     desliga agora; continua habilitado para o próximo boot\n'
    printf '  disable  desliga e também remove/desativa o autostart\n'
    printf '  update   atualiza o filemanagerctl do sistema (/usr/local/bin)\n'
}

case "${1:-}" in
    start)   start_server ;;
    stop)    stop_server ;;
    restart) restart_server ;;
    status)  show_status ;;
    disable) disable_autostart ;;
    enable)  enable_autostart ;;
    update|--update|update-system|--update-system) update_system_controller ;;
    *)       usage; exit 2 ;;
esac
