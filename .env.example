# Token opcional do Codex no workspace ChatGPT Enterprise.
# Se ele for ausente ou recusado, o serviço usa a sessão criada por `codex login`.
# Gere seu próprio token e nunca versione o valor real.
CODEX_ACCESS_TOKEN=your-access-token

# Opcional: caminho absoluto para o executável Codex.
# Deixe vazio para procurar o comando "codex" automaticamente no PATH.
CODEX_BIN=

# Export these variables to the supervisor/service (the PHP runtime does not load .env).
# A fixed external origin is required behind a reverse proxy. No trailing slash.
# FILEMANAGER_ORIGIN=https://files.example.com
# Absolute workspace roots as JSON; never the app, its parents, or filesystem root.
# FILEMANAGER_ALLOWED_ROOTS=["/srv/workspaces/project"]
# Optional private token store, outside any writable workspace.
# FILEMANAGER_TOKENS_FILE=/var/lib/filemanager/tokens.lotus
# Optional Git clone host allowlist (HTTPS only, no redirects/custom transports).
# FILEMANAGER_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
# Bridge secret is generated in .runtime/bridge-secret (0600). Never send it to a browser.
