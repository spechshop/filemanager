includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    phpVersion: 80300
    rememberPossiblyImpureFunctionValues: false
    paths:
        - plugins
        - middleware.php
        - pty.php
        - server.php
    scanFiles:
        - scripts/security/phpstan-external.stub
    scanDirectories:
        - vendor/swoole/ide-helper/src
    tmpDir: .cache/phpstan
