# Raw local test reports may contain usernames, paths, IPs and process commands.
# These rules also describe tracked reports; Git keeps tracking existing files.
/docs/performance/results/
/docs/security/hardening-results/
/docs/*-tests.txt
/docs/*-evidence.txt
/docs/startup-diagnostics-before.txt
/docs/startup-diagnostics-after.txt
/docs/*-results.json
/docs/mobile-terminal-*.txt
/docs/validacao-terminal/
/docs/security/before*.txt
/docs/security/after*.txt
/docs/security/check-results.json
/docs/security/ci-results.json
/docs/security/runtime-local.json
/docs/security/npm-lsp/local-results.txt
/docs/security/npm-lsp/dependency-tree.txt

# Runtime data generated by the application
/files/**
!/files/.gitkeep
!/files/README.md
!/files/webhook/
!/files/webhook/**
/files/webhook/storage/
/database/codex-preferences.lotus
/.runtime/
/sessions-terminals.json
/terminals.json
/terminals.json.backup
/cookies.json
/4o.json
/stubs-generated.json
/stubs-paths.json
/stubs/

# Runtime locks, including locks for ignored private JSON stores.
# Keep dependency manifests (composer.lock and package-lock.json) versionable.
/sessions-terminals.json.lock
/terminals.json.lock
/cookies.json.lock
/4o.json.lock
/stubs-generated.json.lock
/stubs-paths.json.lock
/plugins/configInterface.json.lock
/database/*.lotus.lock

